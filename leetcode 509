/* Fibonacci Number
The Fibonacci numbers, commonly denoted F(n) form a sequence, called the Fibonacci sequence, such that each number is the sum of the two preceding ones, starting from 0 and 1. That is,
F(0) = 0, F(1) = 1
F(n) = F(n - 1) + F(n - 2), for n > 1.
Given n, calculate F(n).
*/



//Method 1 : Recursion

class Solution {
    public int fib(int n) {
        if(n<=1) return n;
		return fib(n-1)+fib(n-2);  
    }
}


//Method 2 : Recursion + Memoization(Top Down)

class Solution {
    public int helper(int n , int[] dp){
        if(n<=1) return n;
        if(dp[n]!=0) return dp[n]; // new
        int ans = helper(n-1,dp) + helper(n-2,dp);
        dp[n] = ans;  //new
        return ans;
    }
    public int fib(int n) {
        int[] dp = new int[n+1]; //index from 0 to n
        return helper(n,dp);
    }
}


//Method 3 : Tabulation(Iterative /Bottom Up)

class Solution {
    public int fib(int n) {
        if(n<=1) return n;
        int[] dp = new int[n+1];
        dp[0] = 0 ; dp[1] = 1;
        for(int i=2;i<=n;i++){
            dp[i] = dp[i-1] + dp[i-2];
        }
        return dp[n];
    }
}

//Method 4 : Tabulation(Space Optimization)

class Solution {
    public int fib(int n) {
        if(n<2) return n;
        int[] dp = new int[3];
        dp[0] = 0;
        dp[1] = 1;

        for(int i = 0 ;i< n-1 ;i++){
            dp[2] = dp[1] + dp[0];
            dp[0] = dp[1];
            dp[1] = dp[2];
        }
        return dp[2];
    }
}
