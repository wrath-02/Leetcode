//Find Numbers with Even Number of Digits
//Given an array nums of integers, return how many of them contain an even number of digits.


//Method 1:
class Solution {
    public int findNumbers(int[] nums) {
        int count = 0;
        for(int num : nums){
            String s = Integer.toString(num);
            if(s.length()%2 == 0) count++;
        }
        return count;
    }
}

//Method 2: 
class Solution {
    public int findNumbers(int[] nums) {
        int count = 0;
        for(int num : nums){
            int digits = 0;
            while(num > 0){
                num /= 10;
                digits++;
            }
            if(digits % 2 == 0) count++;
        }
        return count;
    }
}

//Method 3 : Constraints only
class Solution {
    public int findNumbers(int[] nums) {
        int count = 0;
        for(int num : nums) {
            if((num >= 10 && num <= 99) || (num >= 1000 && num <= 9999) || num == 100000){
                count++;
            }
        }
        return count;
    }

}
