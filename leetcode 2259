//Remove Digit from Number to maximize result
//You are given a string number representing a positive integer and a character digit.
//Return the resulting string after removing exactly one occurrence of digit from number such that the value of the resulting string in decimal form is maximized. The test cases are generated such that digit occurs at least once in number.




class Solution {
    public String removeDigit(String number, char digit) {
        int n = number.length();
        int bestIndex = -1;
        
        for (int i = 0; i < n; i++) {
            if (number.charAt(i) == digit) {
                // Check if removing this digit makes the number larger
                if (i < n - 1 && number.charAt(i) < number.charAt(i + 1)) {
                    return number.substring(0, i) + number.substring(i + 1);
                }
                // Keep track of the last occurrence as a fallback
                bestIndex = i;
            }
        }

        // If no "better" removal found, remove the last occurrence
        return number.substring(0, bestIndex) + number.substring(bestIndex + 1);
    }
}
