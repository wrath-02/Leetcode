//Pow(x,n)
//Implement pow(x, n), which calculates x raised to the power n (i.e., x^n).

class Solution {
    public double myPow(double x, int n) {
        if (n == 0) return 1;
        
        long N = n;
        if (N < 0) {
            x = 1 / x;
            N = -N;
        }
        
        if (N % 2 == 0) {
            double half = myPow(x * x, (int)(N / 2));
            return half;
        } else {
            double half = myPow(x * x, (int)(N / 2));
            return x * half;
        }
    }
}
