//Find N Unique Integers Sum up to Zero
//Given an integer n, return any array containing n unique integers such that they add up to 0.



class Solution {
    public int[] sumZero(int n) {
        int[] ans = new int[n];
        if(n%2 == 0){
            for(int i = 0; i < n/2 ;i++){
                ans[i] = i+1;
            }

            for(int i = n/2 ;i< n ;i++){
                ans[i] = -(ans[n-i-1]);
            }
        }
        else{
            ans[n/2] = 0;
            for(int i = 0; i < n/2 ;i++){
                ans[i] = i+1;
            }

            for(int i = n/2+1 ;i< n ;i++){
                ans[i] = -(ans[n-i-1]);
            }
        }

        return ans;
    }
}
