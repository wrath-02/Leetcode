//Single element in a sorted array
//You are given a sorted array consisting of only integers where every element appears exactly twice, except for one element which appears exactly once.
//Return the single element that appears only once.
//Your solution must run in O(log n) time and O(1) space.





class Solution {
    public int singleNonDuplicate(int[] nums) {
        int l = 0, r = nums.length - 1;
        while (l < r) {  // No need for `l <= r`, otherwise mid might go out of bounds
            int mid = l + (r - l) / 2;
            // Ensure mid is even, so that we always compare with its pair
            if (mid % 2 == 1) {
                mid--;  // If mid is odd, move back one step to make it even
            }
            // If mid and mid+1 are same, the single element is on the right
            if (nums[mid] == nums[mid + 1]) {
                l = mid + 2;  // Move past the pair
            } else {
                r = mid;  // Single element is on the left
            }
        }

        return nums[l];  // At the end, `l` will point to the single element
    }
}
