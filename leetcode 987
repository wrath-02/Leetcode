//Vertical Order Traversal of a Binary Tree
//Given the root of a binary tree, calculate the vertical order traversal of the binary tree.
//For each node at position (row, col), its left and right children will be at positions (row + 1, col - 1) and (row + 1, col + 1) respectively. The root of the tree is at (0, 0).
//The vertical order traversal of a binary tree is a list of top-to-bottom orderings for each column index starting from the leftmost column and ending on the rightmost column. There may be multiple nodes in the same row and same column. In such a case, sort these nodes by their values.
//Return the vertical order traversal of the binary tree.


class Solution {
    class Pair {
        int horizDist;
        int level;
        TreeNode node;

        Pair(int horizDist, int level, TreeNode node) {
            this.horizDist = horizDist;
            this.level = level;
            this.node = node;
        }
    }
    public List<List<Integer>> verticalTraversal(TreeNode root) {
        if (root == null) return new ArrayList<>();

        // TreeMap stores horizontal distance -> List of (level, value)
        TreeMap<Integer, List<int[]>> mp = new TreeMap<>();
        Queue<Pair> q = new LinkedList<>();
        q.add(new Pair(0, 0, root));

        while (!q.isEmpty()) {
            Pair temp = q.poll();
            int dist = temp.horizDist;
            int level = temp.level;
            TreeNode node = temp.node;

            if (mp.containsKey(dist)) {
                mp.get(dist).add(new int[]{level, node.val});
            } else {
                List<int[]> t = new ArrayList<>();
                t.add(new int[]{level, node.val});
                mp.put(dist, t);
            }
            if (node.left != null) q.add(new Pair(dist - 1, level + 1, node.left));
            if (node.right != null) q.add(new Pair(dist + 1, level + 1, node.right));
        }

        List<List<Integer>> result = new ArrayList<>();

        for (List<int[]> nodes : mp.values()) {
            // **Manual Sorting**: First by level, then by value
            Collections.sort(nodes, (a, b) -> {
                if (a[0] == b[0]) return Integer.compare(a[1], b[1]); // If levels are same,sort by value
                return Integer.compare(a[0], b[0]); // Otherwise, sort by level
            });

            // Extract only the node values
            List<Integer> sortedValues = new ArrayList<>();
            for (int[] nodeInfo : nodes) {
                sortedValues.add(nodeInfo[1]);
            }

            result.add(sortedValues);
        }

        return result;
    }
}
