//Construct Binary Tree from Inorder and Postorder Traversal
//Given two integer arrays inorder and postorder where inorder is the inorder traversal of a binary tree and postorder is the postorder traversal of the same tree, construct and return the binary tree.

class Solution {
    public TreeNode helper(int[] inorder, int[] postorder,int postlow ,int posthigh ,int inlow ,int inhigh){
        if(posthigh<postlow || inlow>inhigh) return null;
        TreeNode root = new TreeNode(postorder[posthigh]);
        int r = 0;
        while(inorder[r]!=postorder[posthigh]){
            r++;
        }    
        int leftsize= r-inlow;
        root.left = helper(inorder, postorder, postlow, postlow + leftsize - 1, inlow, r - 1);
        root.right = helper(inorder, postorder, postlow + leftsize, posthigh - 1, r + 1, inhigh);
        return root;
    }
    public TreeNode buildTree(int[] inorder, int[] postorder) {
        int n = postorder.length;
        return helper(inorder, postorder, 0, postorder.length - 1, 0, inorder.length - 1);
    }
}
