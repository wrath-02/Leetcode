import java.util.ArrayList;

class Solution {
    public int[] vowelStrings(String[] words, int[][] queries) {
        // Array to store prefix sums
        int[] prefix = new int[words.length + 1];
        String vowels = "aeiou";

        // Populate prefix sums based on valid vowel strings
        for (int i = 0; i < words.length; i++) {
            String str = words[i];
            int n = str.length();

            // Check if the first and last characters are vowels
            if (vowels.contains("" + str.charAt(0)) && vowels.contains("" + str.charAt(n - 1))) {
                prefix[i + 1] = prefix[i] + 1; // Increment count
            } else {
                prefix[i + 1] = prefix[i]; // Carry forward count
            }
        }

        // Process queries
        int[] ans = new int[queries.length];
        for (int i = 0; i < queries.length; i++) {
            int l = queries[i][0];
            int r = queries[i][1];
            // Use prefix sum to calculate the count in range [l, r]
            ans[i] = prefix[r + 1] - prefix[l];
        }

        return ans;
    }
}
