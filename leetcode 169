class Solution {
    public int majorityElement(int[] nums) {
        int n = nums.length;
        int candidate =0;
        for (int i = 0; i < n; i++) {
            int count = 0;  
            candidate = nums[i];

            for (int j = 0; j < n; j++) {
                if (nums[j] == candidate) {
                    count++;
                }
            }

            if (count > n / 2) {
                break;
            }
        }
        return candidate;
    }
}
