class Solution {
    public boolean isArraySpecial(int[] nums) {
        int n = nums.length;
        if (n == 1) return true; // A single-element array is trivially "special"
        
        for (int i = 0; i < n - 1; i++) {
            if ((nums[i] % 2 == 0 && nums[i + 1] % 2 == 0) || 
                (nums[i] % 2 != 0 && nums[i + 1] % 2 != 0)) {
                return false; // Found two consecutive even or odd numbers
            }
        }
        return true; // If we reach here, the array follows an alternating pattern
    }
}
