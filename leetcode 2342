// MAXIMUM SUM OF A PAIR WITH EQUAL SUM OF DIGITS
//You are given a 0-indexed array nums consisting of positive integers. You can choose two indices i and j, such that i != j, and the sum of digits of the number nums[i] is equal to that of nums[j].
//Return the maximum value of nums[i] + nums[j] that you can obtain over all possible indices i and j that satisfy the conditions.



class Solution {
    public int sumDigits(int number) {
        int sum = 0;
        while (number > 0) {
            sum += number % 10;
            number /= 10;
        }
        return sum;
    }

    public int maximumSum(int[] nums) {
        int ans = -1;
        HashMap<Integer, Integer> digitSumMap = new HashMap<>();

        for (int num : nums) {
            int sumDigits = sumDigits(num);
            if (digitSumMap.containsKey(sumDigits)) {
                ans = Math.max(ans, num + digitSumMap.get(sumDigits));
                digitSumMap.put(sumDigits, Math.max(digitSumMap.get(sumDigits), num));
            } else {
                digitSumMap.put(sumDigits, num);
            }
        }
        return ans;
    }
}
